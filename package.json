{
  "name": "vigilo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:milestone1 && next build",
    "build:milestone1": "tsc -p tsconfig.milestone1.json",
    "start": "next start",
    "typecheck": "npm run typecheck:milestone1 && npm run typecheck:web && npm run typecheck:web-tests",
    "typecheck:milestone1": "tsc --noEmit -p tsconfig.milestone1.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:web-tests": "tsc --noEmit -p tsconfig.web-test.json",
    "test": "npm run test:milestone1 && npm run test:web",
    "test:milestone1": "npm run build:milestone1 && node --test dist/test/*.test.js",
    "test:web": "tsc -p tsconfig.web-test.json && node --test .web-test-dist/web-test/*.test.js",
    "probe": "node --env-file-if-exists=.env.local dist/src/probe.js",
    "baseline": "node --env-file-if-exists=.env.local dist/src/baseline.js",
    "candidate": "node --env-file-if-exists=.env.local dist/src/freeze-candidate.js",
    "verify": "node --env-file-if-exists=.env.local dist/src/verify-candidate.js",
    "evidence": "node dist/src/evidence-report.js",
    "failures": "node --env-file-if-exists=.env.local dist/src/failure-probe.js",
    "demo": "npm run build:milestone1 --silent && node --env-file-if-exists=.env.local dist/src/demo.js",
    "demo:failure": "npm run build:milestone1 --silent && node --env-file-if-exists=.env.local dist/src/demo.js --failure"
  },
  "dependencies": {
    "@vercel/sandbox": "3.2.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/async-retry": "1.4.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2"
  }
}
