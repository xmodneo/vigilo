{
  "name": "vigilo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:milestone1 && next build",
    "build:milestone1": "tsc -p tsconfig.milestone1.json",
    "start": "next start",
    "typecheck": "npm run typecheck:milestone1 && npm run typecheck:web && npm run typecheck:web-tests && npm run typecheck:auth-tests",
    "typecheck:milestone1": "tsc --noEmit -p tsconfig.milestone1.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:web-tests": "tsc --noEmit -p tsconfig.web-test.json",
    "typecheck:auth-tests": "tsc --noEmit -p tsconfig.auth-test.json",
    "test": "npm run test:milestone1 && npm run test:web && npm run test:auth",
    "test:milestone1": "npm run build:milestone1 && node --test dist/test/*.test.js",
    "test:web": "node -e \"require('node:fs').rmSync('.web-test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.web-test.json && node --test .web-test-dist/web-test/*.test.js",
    "test:auth": "node -e \"require('node:fs').rmSync('.auth-test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.auth-test.json && node --test .auth-test-dist/auth-test/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db/migrate.ts",
    "probe": "node --env-file-if-exists=.env.local dist/src/probe.js",
    "baseline": "node --env-file-if-exists=.env.local dist/src/baseline.js",
    "candidate": "node --env-file-if-exists=.env.local dist/src/freeze-candidate.js",
    "verify": "node --env-file-if-exists=.env.local dist/src/verify-candidate.js",
    "evidence": "node dist/src/evidence-report.js",
    "failures": "node --env-file-if-exists=.env.local dist/src/failure-probe.js",
    "demo": "npm run build:milestone1 --silent && node --env-file-if-exists=.env.local dist/src/demo.js",
    "demo:failure": "npm run build:milestone1 --silent && node --env-file-if-exists=.env.local dist/src/demo.js --failure"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@vercel/sandbox": "3.2.1",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/async-retry": "1.4.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/semver": "7.8.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
