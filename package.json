{
  "name": "vigilo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "probe": "node --env-file-if-exists=.env.local dist/src/probe.js",
    "baseline": "node --env-file-if-exists=.env.local dist/src/baseline.js",
    "candidate": "node --env-file-if-exists=.env.local dist/src/freeze-candidate.js",
    "verify": "node --env-file-if-exists=.env.local dist/src/verify-candidate.js",
    "evidence": "node dist/src/evidence-report.js",
    "failures": "node --env-file-if-exists=.env.local dist/src/failure-probe.js",
    "demo": "npm run build --silent && node --env-file-if-exists=.env.local dist/src/demo.js",
    "demo:failure": "npm run build --silent && node --env-file-if-exists=.env.local dist/src/demo.js --failure"
  },
  "dependencies": {
    "@vercel/sandbox": "3.2.1"
  },
  "devDependencies": {
    "@types/async-retry": "1.4.9",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
