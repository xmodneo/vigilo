{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".web-test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "next.config.ts",
    "app/page.tsx",
    "app/api/health/route.ts",
    "web-test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next", ".web-test-dist"]
}
